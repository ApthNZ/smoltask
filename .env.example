# smoltask holds no secrets today: there is no authentication and no outbound
# network access. Every setting below is optional.
#
# When the Jira promote feature lands it will add SMOLTASK_JIRA_URL,
# SMOLTASK_JIRA_TOKEN and SMOLTASK_JIRA_PROJECT. Those are real secrets: put
# them in .env, which is gitignored, and never in a tracked file.

# Path to the SQLite database. Defaults to smoltask.db beside the code.
# The container image sets this to /data/smoltask.db, on a volume.
SMOLTASK_DB=/data/smoltask.db

# Host port published by docker-compose. Defaults to 8108.
SMOLTASK_PORT=8108

# The address docker-compose publishes that port on. Defaults to 127.0.0.1,
# this machine only. 0.0.0.0 serves it to your network — and then set
# SMOLTASK_ALLOWED_HOSTS too, or every request by the LAN name is refused.
SMOLTASK_BIND=127.0.0.1

# The names and addresses the app answers to, comma-separated, ports optional.
# Blank means localhost, 127.0.0.1 and [::1]. Add the hostname or address you
# type into the browser — e.g. localhost,127.0.0.1,notebook.example —
# and a reverse proxy's public name if one sits in front. A request naming any
# other host is refused; that is what stops DNS rebinding. `*` turns the check
# off, for when a proxy in front already does it.
SMOLTASK_ALLOWED_HOSTS=

# The timezone the person using this lives in, e.g. Europe/London,
# America/New_York, Pacific/Auckland. A container with no TZ runs in UTC, and
# every "today" in the app — the day's tick count, due today, the morning
# ritual — is then a day out for part of every day. The page warns you if the
# server's date and your browser's date disagree.
TZ=UTC
